@model AsistenciaWeb.Models.Docente

@{
    ViewData["Title"] = "Eliminar Docente";
}

<h1>Eliminar Docente</h1>

<div>
    <p>¿Está seguro de que desea eliminar este docente?</p>
</div>

<ul class="list-group">
    <li class="list-group-item"><strong>Nombre:</strong> @Model.nombre</li>
    <li class="list-group-item"><strong>Apellido:</strong> @Model.apellido</li>
    <li class="list-group-item"><strong>Correo:</strong> @Model.correo</li>
</ul>

<form asp-action="Delete">
    <input type="hidden" asp-for="id_docente" />
    <button type="submit" class="btn btn-danger mt-3">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>
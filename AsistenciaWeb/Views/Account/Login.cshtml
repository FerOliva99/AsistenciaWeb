@{
    ViewData["Title"] = "Login";
}

<h2 class="text-center my-4">Login</h2>

<div class="text-center">
    <img src="~/img/usuario.png" alt="Logo UNAB" style="width:220px; margin-bottom:5px;" />
</div>

<form asp-action="Login" method="post" class="container mt-4 p-4 border rounded shadow-sm" style="max-width: 400px;">
    <div class="mb-3">
        <label class="form-label">Correo:</label>
        <input type="text" name="correo" required class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña:</label>
        <input type="password" name="contrasena" required class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <p class="text-danger text-center mt-3">
        @ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
    </p>
}

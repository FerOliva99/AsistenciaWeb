@model IEnumerable<AsistenciaWeb.Models.Grupo>

@{
    ViewData["Title"] = "Grupos";
}

<h2>Lista de Grupos</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear Grupo</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Materia</th>
            <th>Docente</th>
            <th>Horario</th>
            <th>Aula</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id_grupo</td>
                <td>@item.id_materiaNavigation?.nombre</td>
                <td>@item.id_docenteNavigation?.nombre</td>
                <td>@item.horario</td>
                <td>@item.aula</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.id_grupo">Detalles</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.id_grupo">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.id_grupo">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

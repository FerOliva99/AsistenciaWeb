        })
            .then(r => r.json())
            .then(data => {
                alert(data.mensaje);
            });
        */

       /*
       fetch(`/Asistencia/RegistrarAsistenciaIndividual?idEstudiante=${idEstudiante}&idGrupo=${idGrupo}`, { method: "POST" })
        .then(r => r.json())
        .then(data => {
            alert(data.mensaje);
        });

        if (data.ok) {
                // Limpiar el input de carnet
                var carnetInput = document.getElementById("carnetInput");
                carnetInput.value = "";

                // Limpiar idEstudiante
                document.getElementById("idEstudiante").value = "";

                // Ocultar la tarjeta de info del estudiante
                var infoEst = document.getElementById("infoEstudiante");
                infoEst.classList.add("d-none");


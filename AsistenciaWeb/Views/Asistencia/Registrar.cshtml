@model AsistenciaWeb.Models.Grupo

<h1>Registrar Asistencia</h1>

<h3 class="mt-2">Detalles del Grupo</h3>

<ul class="list-group">
    <li class="list-group-item"><strong>ID Grupo:</strong> @Model.id_grupo</li>
    <li class="list-group-item"><strong>Materia:</strong> @Model.id_materiaNavigation?.nombre</li>
    <li class="list-group-item"><strong>Docente:</strong> @Model.id_docenteNavigation?.nombre</li>
    <li class="list-group-item"><strong>Horario:</strong> @Model.horario</li>
    <li class="list-group-item"><strong>Aula:</strong> @Model.aula</li>
</ul>

<h3>Buscar Estudiante por Carnet</h3>

<div class="input-group mb-3">
    <input type="text" id="carnetInput" class="form-control" placeholder="Ingrese carnet del estudiante" />
    <button class="btn btn-primary" type="button" onclick="buscarEstudiante()">Buscar</button>
</div>

<div id="resultadoEstudiante" class="alert d-none"></div>

<div id="infoEstudiante" class="card d-none mt-4">
    <div class="card-body">
        <h5 class="card-title" id="estNombre"></h5>
        <p class="card-text" id="estCarnet"></p>

        <button class="btn btn-success" onclick="registrarAsistencia()">Registrar Asistencia</button>
    </div>
</div>

<input type="hidden" id="idGrupo" value="@Model.id_grupo" />
<input type="hidden" id="idEstudiante" />

<script>
    function buscarEstudiante() {
        var carnet = document.getElementById("carnetInput").value;
        var idGrupo = document.getElementById("idGrupo").value;

        fetch(`/Asistencia/BuscarEstudiante?carnet=${carnet}&idGrupo=${idGrupo}`)
            .then(r => r.json())
            .then(data => {
                var msg = document.getElementById("resultadoEstudiante");

                if (!data.ok) {
                    msg.className = "alert alert-danger";
                    msg.innerText = data.mensaje;
                    msg.classList.remove("d-none");
                    document.getElementById("infoEstudiante").classList.add("d-none");
                    return;
                }

                msg.className = "alert alert-success";
                msg.innerText = "Estudiante encontrado";
                msg.classList.remove("d-none");

                document.getElementById("idEstudiante").value = data.estudiante.id;
                document.getElementById("estNombre").innerText =
                    data.estudiante.nombre + " " + data.estudiante.apellido;
                document.getElementById("estCarnet").innerText =
                    "Carnet: " + data.estudiante.carnet;

                document.getElementById("infoEstudiante").classList.remove("d-none");
            });
    }

    async function registrarAsistencia() {
        /*
        var idEstudiante = document.getElementById("idEstudiante").value;

                msg.textContent = "";
                msg.classList.add("d-none");

                // Colocar foco nuevamente en el input de carnet
                carnetInput.focus();
        }*/

        try {
            var idEstudiante = document.getElementById("idEstudiante").value;
            var idGrupo = document.getElementById("idGrupo").value;

            if (!idEstudiante) {
                alert("No hay estudiante seleccionado.");
                return;
            }

            // Llamada al endpoint
            let response = await fetch(`/Asistencia/RegistrarAsistenciaIndividual?idEstudiante=${idEstudiante}&idGrupo=${idGrupo}`, { method: "POST" });
            let data = await response.json();

            // Mostrar mensaje
            alert(data.mensaje);

            if (data.ok) {
                // Limpiar input de carnet
                let carnetInput = document.getElementById("carnetInput");
                carnetInput.value = "";

                // Limpiar idEstudiante oculto
                document.getElementById("idEstudiante").value = "";

                // Ocultar tarjeta del estudiante
                let infoEst = document.getElementById("infoEstudiante");
                infoEst.classList.add("d-none");

                // Ocultar mensaje previo
                let msg = document.getElementById("resultadoEstudiante");
                msg.textContent = "";
                msg.classList.add("d-none");

                // Enfocar de nuevo en el input
                carnetInput.focus();
            }
        } catch (err) {
            console.error("Error al registrar asistencia:", err);
        }
    }
</script>

@model AsistenciaWeb.Models.Estudiante_Grupo

@{
    ViewData["Title"] = "Detalle del Registro";
}

<h2>Detalle del Estudiante en el Grupo</h2>

<div class="card shadow-sm p-4 mt-3">
    <h4 class="mb-3">Información del Estudiante</h4>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">
            @Model.id_estudianteNavigation.nombre @Model.id_estudianteNavigation.apellido
        </dd>

        <dt class="col-sm-3">Carnet</dt>
        <dd class="col-sm-9">
            @Model.id_estudianteNavigation.carnet
        </dd>
    </dl>

    <hr />

    <h4 class="mb-3">Información del Grupo</h4>
    <dl class="row">
        <dt class="col-sm-3">ID Grupo</dt>
        <dd class="col-sm-9">
            @Model.id_grupoNavigation.id_grupo
        </dd>

        <dt class="col-sm-3">Materia</dt>
        <dd class="col-sm-9">
            @Model.id_grupoNavigation.id_materiaNavigation.nombre
            ( @Model.id_grupoNavigation.id_materiaNavigation.codigo )
        </dd>

        <dt class="col-sm-3">Docente</dt>
        <dd class="col-sm-9">
            @Model.id_grupoNavigation.id_docenteNavigation.nombre
            @Model.id_grupoNavigation.id_docenteNavigation.apellido
        </dd>

        <dt class="col-sm-3">Horario</dt>
        <dd class="col-sm-9">
            @Model.id_grupoNavigation.horario
        </dd>

        <dt class="col-sm-3">Aula</dt>
        <dd class="col-sm-9">
            @Model.id_grupoNavigation.aula
        </dd>
    </dl>
</div>

<div class="mt-4">
    <a class="btn btn-primary mt-3" asp-action="Edit" asp-route-id="@Model.id_estudiante_grupo">Editar</a>
    <a class="btn btn-secondary mt-3" asp-action="Index">Volver</a>
</div>

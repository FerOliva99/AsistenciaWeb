@model AsistenciaWeb.Models.Estudiante

@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<h1>Eliminar Estudiante</h1>

<div>
    <p>¿Está seguro de que desea eliminar este estudiante?</p>
</div>

<ul class="list-group">
    <li class="list-group-item"><strong>Código de Barras:</strong> @Model.codigo_barras</li>
    <li class="list-group-item"><strong>Carnet:</strong> @Model.carnet</li>
    <li class="list-group-item"><strong>Nombre:</strong> @Model.nombre</li>
    <li class="list-group-item"><strong>Apellido:</strong> @Model.apellido</li>
    <li class="list-group-item"><strong>Carrera:</strong> @Model.IdCarreraNavigation?.NombreCarrera</li>
    <li class="list-group-item"><strong>Estado:</strong>  @(Model.estado == 1 ? "Activo" : "Inactivo")</li>
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="id_estudiante" />
    <button type="submit" class="btn btn-danger mt-3">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>

@model IEnumerable<AsistenciaWeb.Models.Estudiante>

@{
    ViewData["Title"] = "Lista de Estudiantes";
}

<h2>Lista de Estudiantes</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Estudiante</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Código de Barras</th>
            <th>Carnet</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Carrera</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var estudiante in Model)
        {
            <tr>
                <td>@estudiante.id_estudiante</td>
                <td>@estudiante.codigo_barras</td>
                <td>@estudiante.carnet</td>
                <td>@estudiante.nombre</td>
                <td>@estudiante.apellido</td>
                <td>@estudiante.IdCarrera</td>
                <td>@(estudiante.estado == 1 ? "Activo" : "Inactivo")</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@estudiante.id_estudiante">Detalles</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@estudiante.id_estudiante">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@estudiante.id_estudiante">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

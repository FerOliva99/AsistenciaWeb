@model AsistenciaWeb.Models.Estudiante

@{
    ViewData["Title"] = "Editar Estudiante";
}

<h1>Editar Estudiante</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdEstudiante" />
    <div class="form-group">
        <label asp-for="CodigoBarras"></label>
        <input asp-for="CodigoBarras" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Carnet"></label>
        <input asp-for="Carnet" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Apellido"></label>
        <input asp-for="Apellido" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Carrera"></label>
        <input asp-for="Carrera" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Estado"></label>
        <select asp-for="Estado" class="form-control">
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success mt-3">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>

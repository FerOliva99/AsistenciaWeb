@model IEnumerable<AsistenciaWeb.Models.Carrera>

@{
    ViewData["Title"] = "Carreras";
}

<h2 class="mt-3">Lista de Carreras</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Carrera</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Duración (Años)</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCarrera</td>
                <td>@item.DuracionAnios</td>
                <td>@(item.estado == 1 ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdCarrera" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.IdCarrera" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdCarrera" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

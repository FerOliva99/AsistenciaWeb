@model IEnumerable<AsistenciaWeb.Models.Materium>

@{
    ViewData["Title"] = "Lista de Materias";
}

<h2>Lista de Materias</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear Materia</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Código</th>
            <th>Carrera</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.nombre</td>
                <td>@item.codigo</td>
                <td>@item.IdCarrera</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.id_materia">Detalles</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.id_materia">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.id_materia">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

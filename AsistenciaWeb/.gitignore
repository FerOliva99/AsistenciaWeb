## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# MonoDevelop
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2022 cache/options directory
.vs/

# File-based project configuration
*.opensdf
*.cachefile
*.dbmdl
*.jfm

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
.idea/
*.DotSettings.user

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Azure build files
**/PublishProfiles/*.pubxml
**/PublishProfiles/*.json

# Microsoft Azure Web App publish settings
*.PublishSettings

# NuGet
*.nupkg
# NuGet packages folder
packages/
*.snupkg

# Entity Framework Core
*_MigrationBackup/
Migrations/DesignTime/

# ASP.NET Bundle output
**/bundle/
**/bundles/

# NPM
node_modules/

# Yarn
.yarn/*
!.yarn/patches/
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/

# TypeScript cache
*.tsbuildinfo

# dotenv
.env
.env.*.local

# Logs
*.log
*.tlog

# Backup & misc
*.bak
*.tmp
*.temp

# Rider plugins
.idea/

# VS Code
.vscode/
.history/

# SQLite database (optional)
*.db
*.db-shm
*.db-wal

# IIS Express
iisexpress/
applicationhost.config

# JetBrains Rider settings
.idea/

# Test results
TestResults/
*.trx
.coverage
*.coveragexml

# Others
*.vsidx
*.pidb
*.cache
*.pdb

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
